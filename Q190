class Solution {
public:
    int reverseBits(int n) {
        unsigned int result = 0;   // use unsigned to avoid sign issues
        for (int i = 0; i < 32; i++) {
            result <<= 1;          // shift result left to make space
            result |= (n & 1);     // copy the last bit of n into result
            n >>= 1;               // shift n right to process next bit
        }
        return result;
    }
};
