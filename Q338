class Solution {
public:
    vector<int> countBits(int n) {
        vector<int> ans(n + 1, 0);
        for (int i = 1; i <= n; i++) {
            // Use previously computed result:
            // i >> 1 removes the last bit, ans[i >> 1] is already known
            // (i & 1) adds 1 if the last bit is set
            ans[i] = ans[i >> 1] + (i & 1);
        }
        return ans;
    }
};
