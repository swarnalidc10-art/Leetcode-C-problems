class Solution {
public:
    string addBinary(string a, string b) {
        // Handle empty string cases
        if (a.empty()) return b;
        if (b.empty()) return a;

        string result = "";
        int carry = 0;

        // Start from the last character of both strings
        int i = a.size() - 1;
        int j = b.size() - 1;

        while (i >= 0 || j >= 0 || carry) {
            int sum = carry;

            if (i >= 0) sum += a[i--] - '0'; // Convert char to int
            if (j >= 0) sum += b[j--] - '0';

            // Append the current bit to result
            result.push_back((sum % 2) + '0');

            // Update carry
            carry = sum / 2;
        }

        // Reverse the result since we built it backwards
        reverse(result.begin(), result.end());
        return result;
    }
};

